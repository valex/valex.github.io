{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permission": {
    "bash": {
      "*": "ask",
      "grep *": "allow",
      "ls *": "allow",
      "tail *": "allow",
      "head *": "allow",
      "wc *": "allow",
      "uv *": "allow"
    },
    "edit": {
      "*": "ask",
      "*keys*.json": "deny",
      "*filepaths*.json": "deny"
    },
    "git": {
      "*": "ask",
      "log *": "allow",
      "status *": "allow",
      "diff *": "allow"
    }
  }
}
